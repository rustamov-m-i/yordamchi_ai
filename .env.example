# ============================================================
# YORDAMCHI — Environment Configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to git.
# ============================================================

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# YOUR Telegram user_id (the ONLY user the bot will serve)
# Get it from @userinfobot on Telegram
PRINCIPAL_USER_ID=

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Claude model — sonnet-4-6 is the recommended balance of speed/quality
# Use claude-opus-4-7 for maximum quality (slower, ~5x cost)
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI API key — kept for fallback only. Primary STT is Muxlisa (below).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Whisper model (fallback)
WHISPER_MODEL=whisper-1

# Muxlisa.uz — Uzbek-native STT (PRIMARY voice provider).
# Get key: https://muxlisa.uz/uz/cabinet/api-keys
# Significantly better Uzbek accuracy than OpenAI Whisper, and data stays in Uzbekistan.
#
# NOTE: Aisha AI (below) is now the PRIMARY provider. Muxlisa is kept as a
# secondary fallback during the migration. Delete MUXLISA_API_KEY to fully
# decommission once Aisha is proven in production.
MUXLISA_API_KEY=
MUXLISA_STT_URL=https://service.muxlisa.uz/api/v2/stt

# Aisha AI STT — PRIMARY Uzbek-native voice provider.
# Get key: https://aisha.group/ → cabinet → API keys
# Pay-per-minute (~425 UZS/min in 2026). Data stays in Uzbekistan
# (banking-compliance friendly). Supports uz/ru/en + speaker diarization.
# Endpoint v1 (sync) is best for short Telegram voice messages.
AISHA_API_KEY=
AISHA_STT_URL=https://back.aisha.group/api/v1/stt/post/

# Database path (SQLite file, will be created automatically)
DATABASE_PATH=./data/yordamchi.db

# Timezone (do not change unless you relocate)
TIMEZONE=Asia/Tashkent

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Voice confirmation: AUTO means transcript is shown and processing continues.
# false means the bot asks you to confirm/edit/cancel the transcript before processing.
VOICE_AUTO_CONFIRM=true

# Confirm before creating tasks/meetings. Default true for safety.
CONFIRM_CREATE_ACTIONS=true

# Optional: forward critical errors to this Telegram user_id (usually same as principal)
ERROR_NOTIFY_USER_ID=

# Redaction layer — strips card numbers, account #s, phones, emails, IBANs BEFORE
# sending to Claude/Whisper. Default: enabled. Set to "true" to disable (NOT recommended
# for banking-sensitive use).
REDACTION_DISABLE=false

# ============================================================
# Apple iCloud Calendar (CalDAV) — two-way sync
# ============================================================
# Leave APPLE_ID empty to disable calendar integration entirely.
#
# Setup steps:
#   1. Go to https://account.apple.com → Sign-In and Security
#   2. App-Specific Passwords → Generate Password
#   3. Label it "Yordamchi Bot"; Apple gives you a 16-char password like "abcd-efgh-ijkl-mnop"
#   4. Paste your Apple ID email and that password below
#   5. NEVER use your real Apple ID password — only the App-Specific one
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# Which calendar to sync with (case-sensitive name). Leave blank to use the default ("Home").
# To list available calendars: run `./venv/bin/python -m calendar_service list`
ICLOUD_CALENDAR_NAME=

# How often to pull events from iCloud (minutes). Default 15.
ICLOUD_SYNC_INTERVAL_MIN=15
